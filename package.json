{
  "name": "@ayentic/design-system",
  "version": "0.1.0",
  "description": "Ayentic shared design tokens, PrimeNG theme, and brand assets",
  "private": false,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tokens": "./src/tokens/tokens.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./assets/*": "./src/assets/*",
    "./tailwind-theme.css": "./src/tokens/tailwind-theme.css",
    "./tailwind-v3-extend.cjs": "./src/theme/tailwind-v3-extend.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@angular/core": "^21.2.18",
    "@primeuix/themes": "^2.0.3",
    "primeng": "^21.1.9"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "primeng": {
      "optional": true
    },
    "@primeuix/themes": {
      "optional": true
    }
  },
  "keywords": [
    "ayentic",
    "design-system",
    "primeng",
    "tokens"
  ],
  "license": "UNLICENSED",
  "author": "",
  "devDependencies": {
    "@angular/core": "^21.2.18",
    "@primeuix/themes": "^2.0.3",
    "primeng": "^21.1.9",
    "typescript": "~5.9.2"
  }
}
